+/* Force a single monotonic output timeline. A shared offset maps the (possibly
+ * chaotic) demux timestamps onto a continuous timeline; when the input jumps —
+ * backward, or forward past FP_DISCONTINUITY — we treat it as a segment-boundary
+ * PTS reset and re-anchor so the output simply continues from where it left off.
+ *
+ * The PCR DRIVES the re-anchor (reanchor==true), NOT the ES data. The PCR is the
+ * program clock and in an MPEG-TS it LEADS the ES data, so re-anchoring on it sets
+ * the new segment's offset before any video/audio frame of that segment is emitted.
+ * Every ES (dts/pts) then rides that SAME offset (reanchor==false) → A/V stay locked
+ * AND the clock never lurches. (The earlier version re-anchored on the ES DTS while
+ * the PCR merely followed; because the PCR arrives first, it was emitted with the
+ * stale offset → an ~800ms backward clock jump every segment → late-picture drops
+ * and audio cut-out.) fp_last_out is the high-water-mark of the output and advances
+ * on EVERY timestamp (PCR + all ES) so the continuation point is always correct. */
+vlc_tick_t FakeESOut::forceContinuity(vlc_tick_t ts, bool reanchor)
+{
+    constexpr vlc_tick_t FP_DISCONTINUITY = VLC_TICK_FROM_MS(1000);
+    if(ts == VLC_TICK_INVALID)
+        return ts;
+    if(!fp_have_ref)
+    {
+        /* First timestamp: anchor to the playlist media start if known, else to itself
+         * (a 0-based output is fine — for live we only care about monotonicity). */
+        vlc_tick_t base = (startTimes.media != VLC_TICK_INVALID) ? startTimes.media : ts;
+        fp_offset = base - ts;
+        fp_have_ref = true;
+        fp_last_out = ts + fp_offset;
+        return fp_last_out;
+    }
+    if(reanchor)
+    {
+        vlc_tick_t cand = ts + fp_offset;
+        if(cand < fp_last_out || cand - fp_last_out > FP_DISCONTINUITY)
+        {
+            /* Segment-boundary PTS reset: continue the output right after the last
+             * frame so the clock never jumps. (gap 0 => non-decreasing.) */
+            fp_offset = fp_last_out - ts;
+        }
+    }
+    vlc_tick_t out = ts + fp_offset;
+    /* The continuation point tracks ONLY the PCR (reanchor==true), i.e. the program-clock
+     * position — NOT the ES data. ES streams buffer ahead of the PCR by different amounts
+     * (audio typically leads), so advancing fp_last_out on every ES would make the re-anchor
+     * continue from whichever ES is furthest ahead, dragging the clock forward and the other
+     * ES behind — a runaway A/V divergence (audio races seconds ahead → "playing silence"
+     * waves; video falls seconds behind → "picture too late"). Tracking the PCR alone keeps
+     * each ES at its natural lead/lag relative to the clock, so A/V stay locked. */
+    if(reanchor && out > fp_last_out)
+        fp_last_out = out;
+    return out;
+}
