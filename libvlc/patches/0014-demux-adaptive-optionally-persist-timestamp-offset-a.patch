From 7fa710f7979a11da801419b271e7daeeb12dab82 Mon Sep 17 00:00:00 2001
From: jdistler <josephcd921@gmail.com>
Date: Mon, 29 Jun 2026 19:02:54 -0500
Subject: [PATCH] demux: adaptive: optionally persist timestamp offset across
 restarts

FakeESOut resets timestamps_offset to 0 whenever the timestamp mapping is
cleared between segment demuxer restarts (resetTimestamps -> setExpected/
setAssociatedTimestamp(VLC_TICK_INVALID)). For a well-formed stream the next
segment re-establishes the mapping, but some live HLS origins emit the Apple
ID3 transportStreamTimestamp tag only intermittently: tagged segments are
remapped to the playlist timeline while untagged segments, having no mapping
and a zeroed offset, fall through to their raw broadcast PTS. The output then
oscillates between the two bases (observed: ~7 hour swings on a restream),
which wrecks the clock and freezes playback even though the segments download
fine.

Add "adaptive-ts-offset-persist" (default off). When enabled, clearing the
mapping keeps the previously calculated offset instead of zeroing it, so an
untagged segment continues on the established timeline. Default-off preserves
the existing behaviour exactly; the flag is plumbed from the demux object into
FakeESOut at stream init.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 modules/demux/adaptive/Streams.cpp            |  2 ++
 modules/demux/adaptive/adaptive.cpp           | 10 ++++++++++
 modules/demux/adaptive/plumbing/FakeESOut.cpp |  6 ++++--
 modules/demux/adaptive/plumbing/FakeESOut.hpp |  6 ++++++
 4 files changed, 22 insertions(+), 2 deletions(-)

diff --git a/modules/demux/adaptive/Streams.cpp b/modules/demux/adaptive/Streams.cpp
index 476f43536c..89cefd7b19 100644
--- a/modules/demux/adaptive/Streams.cpp
+++ b/modules/demux/adaptive/Streams.cpp
@@ -84,6 +84,8 @@ bool AbstractStream::init(const StreamFormat &format_, SegmentTracker *tracker)
             {
                 /* All successful */
                 fakeesout->setExtraInfoProvider( this );
+                fakeesout->setPersistTimestampOffset(
+                    var_InheritBool(p_realdemux, "adaptive-ts-offset-persist") );
                 const Role & streamRole = tracker->getStreamRole();
                 if(streamRole.isDefault() && streamRole.autoSelectable())
                     fakeesout->setPriority(ES_PRIORITY_MIN + 10);
diff --git a/modules/demux/adaptive/adaptive.cpp b/modules/demux/adaptive/adaptive.cpp
index de9307d97c..886a8e72e4 100644
--- a/modules/demux/adaptive/adaptive.cpp
+++ b/modules/demux/adaptive/adaptive.cpp
@@ -84,6 +84,14 @@ static void Close   (vlc_object_t *);
 #define ADAPT_LOWLATENCY_TEXT N_("Low latency")
 #define ADAPT_LOWLATENCY_LONGTEXT N_("Overrides low latency parameters")
 
+#define ADAPT_TSPERSIST_TEXT N_("Persist timestamp offset across segment restarts")
+#define ADAPT_TSPERSIST_LONGTEXT N_( \
+    "Keep the established timestamp-mapping offset when a segment demuxer is " \
+    "restarted, instead of resetting it to zero. Some live HLS origins emit only " \
+    "intermittent Apple ID3 transportStreamTimestamp tags, so untagged segments " \
+    "otherwise fall back to raw broadcast PTS and the timeline jumps by hours. " \
+    "Off by default (upstream behaviour); enable for such non-conformant streams.")
+
 static const AbstractAdaptationLogic::LogicType pi_logics[] = {
                                 AbstractAdaptationLogic::LogicType::Default,
                                 AbstractAdaptationLogic::LogicType::Predictive,
@@ -143,6 +151,8 @@ vlc_module_begin ()
                      ADAPT_MAXBUFFER_TEXT, nullptr )
         add_integer( "adaptive-lowlatency", -1, ADAPT_LOWLATENCY_TEXT, ADAPT_LOWLATENCY_LONGTEXT )
             change_integer_list(rgi_latency, ppsz_latency)
+        add_bool   ( "adaptive-ts-offset-persist", false, ADAPT_TSPERSIST_TEXT, ADAPT_TSPERSIST_LONGTEXT )
+            change_safe ()
         set_callbacks( Open, Close )
 vlc_module_end ()
 
diff --git a/modules/demux/adaptive/plumbing/FakeESOut.cpp b/modules/demux/adaptive/plumbing/FakeESOut.cpp
index 2304b56811..1ee40a7edd 100644
--- a/modules/demux/adaptive/plumbing/FakeESOut.cpp
+++ b/modules/demux/adaptive/plumbing/FakeESOut.cpp
@@ -189,7 +189,8 @@ void FakeESOut::setExpectedTimestamp(vlc_tick_t ts)
     if(ts == VLC_TICK_INVALID)
     {
         expected.b_timestamp_set = false;
-        timestamps_offset = 0;
+        if(!b_persist_offset) /* keep prior mapping for untagged restarts */
+            timestamps_offset = 0;
     }
     else if(!expected.b_timestamp_set)
     {
@@ -204,7 +205,8 @@ void FakeESOut::setAssociatedTimestamp(vlc_tick_t ts)
     if(ts == VLC_TICK_INVALID)
     {
         associated.b_timestamp_set = false;
-        timestamps_offset = 0;
+        if(!b_persist_offset) /* keep prior mapping for untagged restarts */
+            timestamps_offset = 0;
     }
     else if(!associated.b_timestamp_set)
     {
diff --git a/modules/demux/adaptive/plumbing/FakeESOut.hpp b/modules/demux/adaptive/plumbing/FakeESOut.hpp
index dbca34eb6c..07817ff778 100644
--- a/modules/demux/adaptive/plumbing/FakeESOut.hpp
+++ b/modules/demux/adaptive/plumbing/FakeESOut.hpp
@@ -92,6 +92,11 @@ namespace adaptive
             void setAssociatedTimestamp( vlc_tick_t, vlc_tick_t );
             void setExpectedTimestamp( vlc_tick_t );
             void resetTimestamps();
+            /* When true, resetting the timestamp mapping (between segment demuxer
+             * restarts) keeps the previously calculated timestamps_offset instead
+             * of zeroing it, so segments lacking a fresh mapping continue on the
+             * established timeline. See "adaptive-ts-offset-persist". */
+            void setPersistTimestampOffset( bool b ) { b_persist_offset = b; }
             size_t esCount() const;
             bool hasSelectedEs() const;
             bool hasSelectedEs(const AbstractFakeESOutID *) const;
@@ -144,6 +149,7 @@ namespace adaptive
                 bool b_offset_calculated;
             } associated, expected;
             vlc_tick_t timestamps_offset;
+            bool b_persist_offset = false;
             int priority;
             bool b_in_commands_group;
             enum class PcrStatus
