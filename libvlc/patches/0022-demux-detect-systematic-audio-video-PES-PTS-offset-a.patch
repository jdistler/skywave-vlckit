From 316762d02d87cf777e5d88bbb83c44e1808767d1 Mon Sep 17 00:00:00 2001
From: jdistler <josephcd921@gmail.com>
Date: Sat, 11 Jul 2026 15:57:32 -0500
Subject: [PATCH] demux: detect audio-video PES PTS offset (TS drift-hint + HLS
 pill signal)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

MLB Network on the fullent Xtream panel delivers video on a ~36s
tape-delay (live-sports compliance buffer) while audio is live, so the
audio-PES PTS is a fixed ~36s ahead of the corresponding video PES's
PTS for the same real event. VLC's default behaviour of scheduling
each track at its labelled PTS yields correctly-synced playback —
video plays immediately, audio is start-deferred by 36s until wall
clock catches up, THEN plays synced.

Detect this at both es_out.c (raw TS path) and FakeESOut::esOutSend
(adaptive HLS path — essential because on HLS the audio ES sits in
the CommandsQueue by media time and never reaches es_out until nearly
the end of the wait). Fire "skywave-avdiff: …" WARN so the app can
show its "audio catching up ~Ns" pill uniformly on both formats. Gate
on |diff|>5s; fire once per session.

On the raw TS path additionally call EsOutSetDelay(-diff). This does
NOT retime the first audio block (stream_Play at dec.c:936 computes
play_date via the filter-path clock BEFORE the delay-apply block at
dec.c:963 — an ordering race no small patch will fix cleanly). But it
DOES inform the drift-correction resampler that audio is intentionally
late, which prevents it from speeding audio up to catch imaginary
lateness. On-device 2026-07-11: patched-15 (no EsOutSetDelay) played
MLB TS "horribly out of sync"; patched-16 (with) played MLB TS
correctly synced after the deferred-start wait.

The FakeESOut path stays detect-only. Original 0022's inline
p_block->i_pts += -diff shift on HLS moved audio 36s ahead of the
video content (bat-crack 36s before the swing visual). Removed.

Local hlslab (Linux, harness + pulse aout):
  MLB TS:  avdiff 36232ms fires, aout defers 36.96s (audio will play
           synced when it arrives).
  MLB HLS: avdiff 36218ms fires via FakeESOut, audio ES held in queue.
  ESPN:    no avdiff, no behavioural change.

Co-Authored-By: Claude Opus 4.7 <noreply@anthropic.com>
---
 modules/demux/adaptive/Streams.cpp            |  3 +-
 modules/demux/adaptive/plumbing/FakeESOut.cpp | 39 +++++++++-
 modules/demux/adaptive/plumbing/FakeESOut.hpp | 17 ++++-
 src/input/es_out.c                            | 74 +++++++++++++++++++
 4 files changed, 130 insertions(+), 3 deletions(-)

diff --git a/modules/demux/adaptive/Streams.cpp b/modules/demux/adaptive/Streams.cpp
index 3415bce02a..677af5e50c 100644
--- a/modules/demux/adaptive/Streams.cpp
+++ b/modules/demux/adaptive/Streams.cpp
@@ -79,7 +79,8 @@ bool AbstractStream::init(const StreamFormat &format_, SegmentTracker *tracker)
         if(factory && commandsqueue)
         {
             fakeesout = new (std::nothrow) FakeESOut(p_realdemux->out,
-                                                     commandsqueue, factory);
+                                                     commandsqueue, factory,
+                                                     VLC_OBJECT(p_realdemux));
             if(fakeesout)
             {
                 /* All successful */
diff --git a/modules/demux/adaptive/plumbing/FakeESOut.cpp b/modules/demux/adaptive/plumbing/FakeESOut.cpp
index 8a60b474b9..4b8b9583e0 100644
--- a/modules/demux/adaptive/plumbing/FakeESOut.cpp
+++ b/modules/demux/adaptive/plumbing/FakeESOut.cpp
@@ -137,7 +137,7 @@ FakeESOut * FakeESOut::LockedFakeEsOut::operator ->()
 }
 
 FakeESOut::FakeESOut( es_out_t *es, AbstractCommandsQueue *queue,
-                      CommandsFactory *cf )
+                      CommandsFactory *cf, vlc_object_t *log_obj )
     : AbstractFakeEsOut()
     , real_es_out( es )
     , extrainfo( nullptr )
@@ -145,6 +145,7 @@ FakeESOut::FakeESOut( es_out_t *es, AbstractCommandsQueue *queue,
     , commandsfactory( cf )
     , timestamps_offset( 0 )
 {
+    sk_log_obj = log_obj;
     associated.b_timestamp_set = false;
     expected.b_timestamp_set = false;
     priority = ES_PRIORITY_SELECTABLE_MIN;
@@ -703,6 +704,42 @@ int FakeESOut::esOutSend(es_out_id_t *p_es, block_t *p_block)
     p_block->i_dts = fixTimestamp( p_block->i_dts );
     p_block->i_pts = fixTimestamp( p_block->i_pts );
 
+    /* Skywave (patch 0022, revised): detect a systematic audio-video PES PTS
+     * offset and emit a signal — DO NOT try to compensate. Original 0022 shifted
+     * audio PTS inline to make it play immediately alongside video, on the theory
+     * that the panel had mis-labelled its PTS. Real behaviour on MLB Network
+     * (confirmed via on-device 2026-07-11): the panel's PTS is honest — video is
+     * delivered on a ~36s tape-delay (live-sports compliance buffering) while
+     * audio is live, so the audio-video PES PTS diff reflects a REAL content-time
+     * offset. Playing audio at wall=0 (as the correction did) made the crack of
+     * the bat land 36s before the visual — badly desynced. Peer to the es_out.c
+     * detector; this one is critical because on adaptive HLS audio blocks with
+     * far-future PTS sit in the CommandsQueue by media time and don't reach
+     * es_out for ~36s, so we would otherwise never emit the pill signal on HLS. */
+    const int cat = es_id->getFmt()->i_cat;
+    if( !sk_avdiff_applied && p_block->i_pts != VLC_TICK_INVALID
+        && ( cat == VIDEO_ES || cat == AUDIO_ES ) )
+    {
+        if( cat == VIDEO_ES && sk_first_video_pts == VLC_TICK_INVALID )
+            sk_first_video_pts = p_block->i_pts;
+        else if( cat == AUDIO_ES && sk_first_audio_pts == VLC_TICK_INVALID )
+            sk_first_audio_pts = p_block->i_pts;
+        if( sk_first_video_pts != VLC_TICK_INVALID
+            && sk_first_audio_pts != VLC_TICK_INVALID )
+        {
+            const vlc_tick_t diff = sk_first_audio_pts - sk_first_video_pts;
+            if( diff > VLC_TICK_FROM_SEC(5) || diff < -VLC_TICK_FROM_SEC(5) )
+            {
+                if( sk_log_obj )
+                    msg_Warn( sk_log_obj,
+                        "skywave-avdiff: first audio-video PES PTS diff %" PRId64 " ms "
+                        "— stream property (no correction, FakeESOut)",
+                        diff / 1000 );
+            }
+            sk_avdiff_applied = true;
+        }
+    }
+
     if(b_force_playlist)
     {
         /* Force a monotonic timeline. ES data FOLLOWS the offset (reanchor=false); the
diff --git a/modules/demux/adaptive/plumbing/FakeESOut.hpp b/modules/demux/adaptive/plumbing/FakeESOut.hpp
index 6768b9d3b9..8b38e299f1 100644
--- a/modules/demux/adaptive/plumbing/FakeESOut.hpp
+++ b/modules/demux/adaptive/plumbing/FakeESOut.hpp
@@ -83,7 +83,8 @@ namespace adaptive
                     FakeESOut *p;
                     LockedFakeEsOut(FakeESOut &q);
             };
-            FakeESOut( es_out_t *, AbstractCommandsQueue *, CommandsFactory * );
+            FakeESOut( es_out_t *, AbstractCommandsQueue *, CommandsFactory *,
+                       vlc_object_t *log_obj = nullptr );
             virtual ~FakeESOut();
             LockedFakeEsOut WithLock();
             AbstractCommandsQueue * commandsQueue();
@@ -163,6 +164,20 @@ namespace adaptive
             bool fp_have_ref = false;
             vlc_tick_t fp_offset = 0;
             vlc_tick_t fp_last_out = VLC_TICK_INVALID;
+            /* Skywave (patch 0022, revised): detect systematic audio-video PES PTS
+             * offset and log it — DO NOT compensate. Peer to the es_out.c detector;
+             * this one is essential for HLS because audio blocks with far-future
+             * PTS sit in the CommandsQueue by media time and don't reach es_out
+             * for ~36s, so es_out.c can't detect. Emitting here lets the app show
+             * the "audio catching up" pill promptly on both TS and HLS. Original
+             * 0022 shifted the audio block's PTS inline; that assumed the panel
+             * had mis-labelled its PTS but it hasn't (video is genuinely delayed
+             * on MLB Network — see log). Applied ONCE per FakeESOut session; a
+             * legitimate small A/V offset (<5s) never trips it. */
+            bool sk_avdiff_applied = false;
+            vlc_tick_t sk_first_video_pts = VLC_TICK_INVALID;
+            vlc_tick_t sk_first_audio_pts = VLC_TICK_INVALID;
+            vlc_object_t *sk_log_obj = nullptr;
             int priority;
             bool b_in_commands_group;
             enum class PcrStatus
diff --git a/src/input/es_out.c b/src/input/es_out.c
index d7f65207fa..c1e3fa7edc 100644
--- a/src/input/es_out.c
+++ b/src/input/es_out.c
@@ -210,6 +210,22 @@ typedef struct
     vlc_tick_t i_spu_delay;
     vlc_tick_t i_video_delay;
 
+    /* Skywave (patch 0022): auto-detect and compensate a systematic audio-video
+     * PTS offset in the source. Some restream panels (fullent for MLB Network on
+     * Xtream) emit TS/HLS where every audio PES's PTS is a fixed ~36s ahead of
+     * the corresponding video PES's PTS. VLC honours PES PTS strictly, so audio
+     * plays 36s desynced from video content — verified via ffmpeg's own
+     * timestamp-discontinuity detection (constant +36.09s audio-side offset on
+     * the wire; ffmpeg's -c copy auto-corrects to align). We measure the first
+     * video + first audio PES PTS in EsOutSend; if |diff| exceeds a threshold
+     * we shift i_audio_delay by -diff to cancel it. Applied ONCE per es_out
+     * session so a legitimate <5s natural A/V offset never trips it, and no
+     * later block can re-trip it. Fires msg_Warn(skywave-avdiff…) so the app's
+     * VLCLogTap can telemeter the correction. */
+    vlc_tick_t skywave_first_video_pts;
+    vlc_tick_t skywave_first_audio_pts;
+    bool       skywave_avdiff_applied;
+
     /* Clock configuration */
     vlc_tick_t  i_pts_delay;
     vlc_tick_t  i_tracks_pts_delay;
@@ -3140,6 +3156,59 @@ static int EsOutSend(es_out_t *out, es_out_id_t *es, block_t *p_block )
         }
     }
 
+    /* Skywave (patch 0022): auto-detect systematic audio-video PES PTS offset.
+     * Some restream panels (fullent MLB Network) deliver video on a ~36s
+     * tape-delay (live-sports compliance buffer) while audio is live, so the
+     * audio-PES PTS is a fixed ~36s ahead of the corresponding video PES.
+     * VLC's default behaviour of scheduling each track at its labelled PTS
+     * yields correctly-synced playback — audio just arrives 36s after open
+     * once wall clock catches up. Two things fall out of that:
+     *   1. UX: emit a WARNING so the app's VLCLogTap can put up an "audio
+     *      catching up ~Ns" pill.
+     *   2. On the raw TS path, ALSO set `i_audio_delay = -diff`. This does
+     *      NOT change the FIRST audio block's play_date (stream_Play at
+     *      dec.c:936 converts play_date via the filter-path clock before the
+     *      delay-apply block at dec.c:963 — a race no small patch will fix
+     *      cleanly), but it DOES inform the drift-correction machinery that
+     *      audio is intentionally late, preventing the resampler from
+     *      speeding audio up to catch imaginary lateness. On-device 2026-07-11
+     *      proved this: patched-15 (no EsOutSetDelay call) played TS
+     *      "horribly out of sync"; patched-16 (with the call) played TS
+     *      correctly synced after the deferred-start wait.
+     *
+     * Gate on |diff|>5s; fire once per es_out session. */
+    if( !p_sys->skywave_avdiff_applied
+        && p_block->i_pts != VLC_TICK_INVALID
+        && ( es->fmt.i_cat == VIDEO_ES || es->fmt.i_cat == AUDIO_ES ) )
+    {
+        if( es->fmt.i_cat == VIDEO_ES
+            && p_sys->skywave_first_video_pts == VLC_TICK_INVALID )
+            p_sys->skywave_first_video_pts = p_block->i_pts;
+        else if( es->fmt.i_cat == AUDIO_ES
+            && p_sys->skywave_first_audio_pts == VLC_TICK_INVALID )
+            p_sys->skywave_first_audio_pts = p_block->i_pts;
+
+        if( p_sys->skywave_first_video_pts != VLC_TICK_INVALID
+            && p_sys->skywave_first_audio_pts != VLC_TICK_INVALID )
+        {
+            const vlc_tick_t diff = p_sys->skywave_first_audio_pts
+                                  - p_sys->skywave_first_video_pts;
+            if( diff > VLC_TICK_FROM_SEC(5) || diff < -VLC_TICK_FROM_SEC(5) )
+            {
+                msg_Warn( p_input,
+                    "skywave-avdiff: first audio-video PES PTS diff %"PRId64" ms "
+                    "— setting audio_delay=%"PRId64" ms (drift-correction hint)",
+                    MS_FROM_VLC_TICK(diff), -MS_FROM_VLC_TICK(diff) );
+                /* Set the audio delay so drift correction doesn't speed audio
+                 * up. Does NOT retime the first block (dec.c ordering race);
+                 * the aout still naturally defers the first block by ~diff ms,
+                 * and the audio arrives synced when wall clock catches up. */
+                EsOutSetDelay( p_sys, AUDIO_ES, -diff );
+            }
+            p_sys->skywave_avdiff_applied = true;
+        }
+    }
+
     /* Drop all ESes except the video one in case of next-frame */
     if( p_sys->p_next_frame_es != NULL && p_sys->p_next_frame_es != es )
     {
@@ -4331,6 +4400,11 @@ input_EsOutNew(input_thread_t *p_input, input_source_t *main_source, float rate,
                        = p_sys->i_last_pts_jitter = VLC_TICK_INVALID;
     p_sys->i_cr_average = 0;
 
+    /* Skywave (patch 0022): audio-video PTS offset auto-detector — see field decls */
+    p_sys->skywave_first_video_pts = VLC_TICK_INVALID;
+    p_sys->skywave_first_audio_pts = VLC_TICK_INVALID;
+    p_sys->skywave_avdiff_applied  = false;
+
     p_sys->user_clock_source = clock_source_Inherit( VLC_OBJECT(p_input) );
     p_sys->i_id = 0;
 
