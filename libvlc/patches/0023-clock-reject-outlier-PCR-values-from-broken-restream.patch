From 25f7c95d349209ab05e46d3c94950b4afbf51661 Mon Sep 17 00:00:00 2001
From: jdistler <josephcd921@gmail.com>
Date: Sun, 12 Jul 2026 08:19:33 -0500
Subject: [PATCH 2/3] clock: reject outlier PCR values from broken restream
 transcoders
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Some Xtream restream transcoders splice a stale near-max-33-bit PCR value
into an ongoing stream at random moments. Verified strong 'RC: ECDF' panel
2026-07-12: after 30 s of clean PCRs growing normally near 95443 s, a fresh
95443 s marker mid-play made VLC's stream_diff<0 recovery path re-anchor
the whole pipeline on the outlier via SetFirstPcr ('new clock context(1)
@95443017689', kVTVideoDecoderBadDataErr), permanently freezing video.

Reject an incoming PCR whose stream time jumps by more than 10 s from the
running reference, once b_has_reference is set (the first PCR at open is
allowed through unconditionally so the existing stream_diff<0 recovery can
handle a stale-then-real startup transition). Safety valve caps consecutive
rejects at 10 so a genuine clock re-base can't be locked out.

The DIFFERENTIAL check (not an absolute-range check on the raw value) is
critical: the panel's actual live PCRs live in the near-max range too
(harness trace: 95443.018 → 95443.717 → 95443.784 → ... growing by 33-100 ms
each). An absolute threshold at 90000 s would reject every real PCR after
the initial latch. Only a JUMP relative to the running reference cleanly
distinguishes the outlier from the continuous timeline.

Reproduced end-to-end via harness + captured stream + synthetic stale-PCR
re-injection. Vanilla libvlc fires 'clock gap ... stream_diff: -5671989',
'new clock context(1) @95443017689', 'flushing static filters' on a spike
injected into a normal timeline. Patched drops the sample under
'skywave-stale-pcr: dropping outlier PCR' and playback stays anchored on the
last-good reference.

Warn is rate-limited to once/500 ms so a chronic panel's rate stays legible
in VLCLogTap without saturating its per-second ceiling.

skywave-audio-tolerance branch.
---
 src/clock/input_clock.c | 103 ++++++++++++++++++++++++++++++++++++++++
 1 file changed, 103 insertions(+)

diff --git a/src/clock/input_clock.c b/src/clock/input_clock.c
index 01d873b679..55f357209d 100644
--- a/src/clock/input_clock.c
+++ b/src/clock/input_clock.c
@@ -85,6 +85,51 @@
 
 #define CR_MAX_GAP CR_MEAN_PTS_GAP
 
+/* Skywave (2026-07-12): drop an incoming PCR whose stream time jumps by more
+ * than the direction-dependent SKYWAVE_MAX_PCR_JUMP_* bound from the running reference. Some Xtream restream
+ * transcoders splice a stale near-max-33-bit PCR value into an ongoing stream
+ * at random moments (verified strong RC: ECDF 2026-07-12: 30 s of clean PCRs
+ * near 95443 s, then a fresh 95443 s marker mid-play makes stream_diff jump
+ * to -21387989 µs — the existing recovery path re-anchors on the outlier via
+ * SetFirstPcr and freezes the pipeline; `new clock context(1) @95443017689`,
+ * kVTVideoDecoderBadDataErr, permanent watch-long freeze).
+ *
+ * A DIFFERENTIAL check catches both known panel patterns cleanly:
+ *   - "stale-then-real reset" (my captured probe session): first PCR is
+ *     stale, second wraps to 0 — startup allowed through unconditionally
+ *     (b_has_reference gate); the -95443 s jump on second PCR trips the
+ *     safety valve after N consecutive rejects and re-anchors on the real
+ *     value.
+ *   - "stays-in-stale-range" (the on-device failure session): first PCR is
+ *     stale, PCRs then advance in the near-max range for 30 s; when another
+ *     stale value is spliced in, |stream_diff| = 21 s jump gets rejected,
+ *     cl->last stays on the last-good reference at ~95464 s, next real PCR
+ *     is normal, playback continues without a discontinuity.
+ *
+ * The guard is ASYMMETRIC by direction (refined 2026-07-12 after the
+ * panelfuzz wild-campaign found the forward false-positive):
+ *   - BACKWARD (stream_diff < 0): a live PCR never legitimately goes back in
+ *     time by seconds — that is always a rewind / stale value / restream
+ *     restart. Reject beyond a tight 10 s (well clear of the 300 ms CR_MAX_GAP
+ *     jitter floor). This is the RC: ECDF -21 s case.
+ *   - FORWARD (stream_diff > 0): a sparse-PCR channel (fullent's 24/7 loop
+ *     channels: MASH, Charlies Angels, …) legitimately steps its PCR forward
+ *     by seconds-to-tens-of-seconds between samples, and a genuine mid-stream
+ *     gap (panel pauses then resumes) is also a real forward jump — those must
+ *     pass to VLC's normal discontinuity handling, NOT be dropped (dropping a
+ *     legit forward step strands cl->last behind and hiccups the next frame).
+ *     Only reject FORWARD jumps large enough to be an uninitialized/stale
+ *     marker: the observed stale values sit near the 33-bit max (~95 443 s),
+ *     so a 60 s forward bound cleanly separates "sparse gap" (< 60 s, allow)
+ *     from "stale splice" (huge, drop) while still catching the
+ *     re-injection-onto-an-established-timeline case.
+ * The streak safety valve prevents a lockout if a panel genuinely does move
+ * its clock base far (session boundary): after MAX_STREAK rejects in a row,
+ * the next sample is accepted and the reference re-anchors normally. */
+#define SKYWAVE_MAX_PCR_JUMP_BACK  VLC_TICK_FROM_SEC(10)
+#define SKYWAVE_MAX_PCR_JUMP_FWD   VLC_TICK_FROM_SEC(60)
+#define SKYWAVE_MAX_REJECT_STREAK  10
+
 /* Rate (in 1/256) at which we will read faster to try to increase our
  * internal buffer (if we control the pace of the source).
  */
@@ -139,6 +184,14 @@ struct input_clock_t
     float   rate;
     vlc_tick_t i_pts_delay;
     vlc_tick_t i_pause_date;
+
+    /* Skywave: number of consecutive PCR samples we've dropped for a
+     * stale-jump. The safety valve — after MAX_STREAK the next sample is
+     * accepted so a genuine clock re-base can't be locked out. */
+    unsigned int skywave_reject_streak;
+    /* Skywave: last system-time we warned about a stale-PCR drop, so a
+     * chronic-emit panel doesn't spam VLCLogTap's per-second ceiling. */
+    vlc_tick_t skywave_last_stale_warn;
 };
 
 static vlc_tick_t ClockStreamToSystem( input_clock_t *, vlc_tick_t i_stream );
@@ -191,6 +244,8 @@ input_clock_t *input_clock_New(struct vlc_logger *logger, float rate)
     cl->rate = rate;
     cl->i_pts_delay = 0;
     cl->b_paused = false;
+    cl->skywave_reject_streak = 0;
+    cl->skywave_last_stale_warn = VLC_TICK_INVALID;
     cl->i_pause_date = VLC_TICK_INVALID;
 
     return cl;
@@ -234,6 +289,54 @@ vlc_tick_t input_clock_Update( input_clock_t *cl,
 
     assert( i_ck_stream != VLC_TICK_INVALID && i_ck_system != VLC_TICK_INVALID );
 
+    /* Skywave (2026-07-12): drop an outlier PCR sample spliced INTO an
+     * ongoing stream (see the SKYWAVE_MAX_PCR_JUMP_* comment). Only fires once a
+     * reference is established — the FIRST PCR at open is allowed through
+     * unconditionally so the existing stream_diff<0 discontinuity path can
+     * handle a stale-then-real startup transition. The actual failure mode
+     * is a LATE re-injection: b_has_reference is true, cl->last has been
+     * drifting steadily on the panel's real timeline, and a fresh stale
+     * value arrives — normally that would trip the discontinuity + re-anchor
+     * on the stale value via SetFirstPcr, freezing the pipeline for the rest
+     * of the watch. Rejecting the sample keeps cl->last on the last-good
+     * reference; the demux's next PCR is normal and playback continues
+     * without a discontinuity.
+     *
+     * Safety valve: after SKYWAVE_MAX_REJECT_STREAK consecutive rejects,
+     * accept the sample and re-anchor normally — a real session boundary
+     * with a genuine clock re-base isn't blocked forever. Warn once every
+     * ~500 ms so a chronic panel's rate stays legible in the log without
+     * saturating VLCLogTap's per-second ceiling. */
+    if( cl->b_has_reference && cl->last.stream != VLC_TICK_INVALID
+     && cl->skywave_reject_streak < SKYWAVE_MAX_REJECT_STREAK )
+    {
+        vlc_tick_t jump = i_ck_stream - cl->last.stream;
+        vlc_tick_t bound = jump < 0 ? SKYWAVE_MAX_PCR_JUMP_BACK
+                                    : SKYWAVE_MAX_PCR_JUMP_FWD;
+        vlc_tick_t abs_jump = jump < 0 ? -jump : jump;
+        if( abs_jump > bound )
+        {
+            vlc_tick_t now = i_ck_system;
+            if( cl->skywave_last_stale_warn == VLC_TICK_INVALID
+             || now - cl->skywave_last_stale_warn >= VLC_TICK_FROM_MS(500) )
+            {
+                vlc_warning(cl->logger,
+                            "skywave-stale-pcr: dropping outlier PCR "
+                            "(jump=%"PRId64" us, streak=%u, incoming=%"PRId64" us, last=%"PRId64" us)",
+                            jump, cl->skywave_reject_streak + 1,
+                            i_ck_stream, cl->last.stream);
+                cl->skywave_last_stale_warn = now;
+            }
+            cl->skywave_reject_streak++;
+            return 0;
+        }
+        cl->skywave_reject_streak = 0;
+    }
+    else
+    {
+        cl->skywave_reject_streak = 0;
+    }
+
     if( !cl->b_has_reference )
     {
         /* */
-- 
